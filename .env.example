# Copy to .env.local for local development. Never commit real secrets.
# The Web app URL you get from Apps Script: Deploy > New deployment > Web app.
# It must end with /exec
NEXT_PUBLIC_SHEETS_API_URL=https://script.google.com/macros/s/YOUR-DEPLOYMENT-ID/exec
# Only for project sites (username.github.io/repo). Leave empty locally.
# NEXT_PUBLIC_BASE_PATH=/repo-name
